# =============================================================================
# Entorno REPLAY (aislado). Copiar a infra/.env.replay (gitignored).
# NUNCA reutilizar secretos de infra/.env
# =============================================================================

# --- Proyecto ---
COMPOSE_PROJECT_NAME=replay

# --- Mongo ---
REPLAY_MONGO_INITDB_ROOT_USERNAME=replay-root
REPLAY_MONGO_INITDB_ROOT_PASSWORD=replay-only-change-me-root
REPLAY_MONGO_APP_USER=replay-app
REPLAY_MONGO_APP_PASSWORD=replay-only-change-me-app
REPLAY_MONGO_WORKER_USER=replay-worker
REPLAY_MONGO_WORKER_PASSWORD=replay-only-change-me-worker
REPLAY_MONOLITO_MONGO_USER=replay-monolito
REPLAY_MONOLITO_MONGO_PASSWORD=replay-only-change-me-monolito
REPLAY_MONGO_DATABASE=documents
REPLAY_MONOLITO_MONGO_DB=pdf-extractext

# --- Redis ---
REPLAY_REDIS_STREAMS_PASSWORD=replay-only-change-me-redis
REPLAY_REDIS_STREAM_KEY=stream:pdf-processing
REPLAY_REDIS_DLQ_KEY=stream:pdf-processing-dlq
REPLAY_REDIS_GROUP=extraction-workers

# --- MinIO ---
REPLAY_MINIO_ROOT_USER=replay-minio-root
REPLAY_MINIO_ROOT_PASSWORD=replay-only-change-me-minio
REPLAY_MINIO_REGION=us-east-1
REPLAY_MINIO_PUBLIC_ENDPOINT=http://localhost:9100
REPLAY_MINIO_WEBHOOK_SECRET=replay-only-change-me-webhook
REPLAY_SVC_DOCSERVICE_ACCESS_KEY=replay-only-change-me-docservice-ak
REPLAY_SVC_DOCSERVICE_SECRET_KEY=replay-only-change-me-docservice-sk
REPLAY_SVC_WORKER_ACCESS_KEY=replay-only-change-me-worker-ak
REPLAY_SVC_WORKER_SECRET_KEY=replay-only-change-me-worker-sk

# --- doc-service ---
REPLAY_DOC_SERVICE_IMAGE=doc-service
REPLAY_DOC_SERVICE_TAG=local
REPLAY_DOC_SERVICE_WEBHOOK_URL=http://doc-service:8080/internal/storage/events
REPLAY_DOC_SERVICE_INTERNAL_TOKEN=replay-only-change-me-internal
REPLAY_DOC_SERVICE_PORT=9080

# --- monolito ---
REPLAY_MONOLITO_IMAGE=monolito:latest
REPLAY_MONOLITO_BUILD_CONTEXT=../../../pdf-extractext

# --- extraction-worker ---
REPLAY_EXTRACTION_WORKER_IMAGE=ghcr.io/alejo-basile/extraction-worker
REPLAY_EXTRACTION_WORKER_TAG=s5p1-closure
