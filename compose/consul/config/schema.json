{
  "doc-service": {
    "max_pdf_bytes": {"type": "int", "min": 1048576, "max": 104857600, "reload": "hot", "default": 26214400},
    "presign_upload_ttl_seconds": {"type": "int", "min": 60, "max": 3600, "reload": "hot", "default": 900},
    "presign_download_ttl_seconds": {"type": "int", "min": 60, "max": 900, "reload": "hot", "default": 300},
    "reconcile_interval_minutes": {"type": "int", "min": 1, "max": 60, "reload": "hot", "default": 10},
    "reconcile_stuck_after_minutes": {"type": "int", "min": 5, "max": 720, "reload": "hot", "default": 30},
    "reconcile_dry_run": {"type": "bool", "reload": "hot", "default": false},
    "doc_upload_grace_minutes": {"type": "int", "min": 5, "max": 240, "reload": "hot", "default": 30, "coherence": "doc_upload_grace_minutes >= 2 * reconcile_interval_minutes"},
    "min_safety_age_minutes": {"type": "int", "min": 1, "max": 120, "reload": "hot", "default": 15, "coherence": "min_safety_age_minutes >= reconcile_interval_minutes"}
  },
  "rate-limiter": {
    "sensitive_routes": {"type": "list", "min": 1, "max": 50, "reload": "hot", "default": "POST /api/v2/documents=5:10"},
    "exempt_paths": {"type": "list", "min": 1, "max": 50, "reload": "hot", "default": "/internal,/healthz,/metrics"}
  },
  "extraction-worker": {
    "bulkhead_max_concurrency": {"type": "int", "min": 1, "max": 64, "reload": "hot-aumento", "default": 4},
    "retry_max_elapsed_seconds": {"type": "int", "min": 1, "max": 600, "reload": "hot", "default": 30},
    "retry_initial_interval_ms": {"type": "int", "min": 10, "max": 60000, "reload": "hot", "default": 500},
    "retry_multiplier": {"type": "float", "min": 1.0, "max": 10.0, "reload": "hot", "default": 1.5},
    "retry_max_interval_ms": {"type": "int", "min": 100, "max": 300000, "reload": "hot", "default": 60000},
    "retry_randomization_factor": {"type": "float", "min": 0.0, "max": 1.0, "reload": "hot", "default": 0.5},
    "breaker_failure_threshold": {"type": "int", "min": 1, "max": 100, "reload": "hot", "default": 5},
    "breaker_timeout_seconds": {"type": "int", "min": 1, "max": 300, "reload": "hot", "default": 30},
    "job_timeout_seconds": {"type": "int", "min": 30, "max": 3600, "reload": "hot-jobs-nuevos", "default": 300},
    "max_pages": {"type": "int", "min": 1, "max": 100000, "reload": "hot-jobs-nuevos", "default": 2000},
    "min_idle_ms": {"type": "int", "min": 1000, "max": 86400000, "reload": "restart", "default": 601000}
  }
}
