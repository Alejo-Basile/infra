# Valores FICTICIOS. Copiar a .env y completar localmente. Nunca commitear el .env real.
# Variante LOCAL (proyecto academico): hosts api.localhost / s3.localhost con mkcert (ver docs/adr/ADR-0016.md).

# --- MinIO (root solo para bootstrap; NUNCA usarla en servicios de aplicacion) ---
MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme
MINIO_REGION=us-east-1
# Endpoint PUBLICO que el doc-service usa para firmar URLs prefirmadas (SPEC §5.1 / ADR-0016).
# La firma SigV4 depende del host: DEBE coincidir con el hostname publico dedicado de S3.
# Si TRAEFIK_HTTPS_PORT no es 443, incluir el puerto (ej. https://s3.localhost:8543).
MINIO_PUBLIC_ENDPOINT=https://s3.localhost

# --- Identidades de servicio MinIO (minimo privilegio, SPEC §3.4) ---
SVC_DOCSERVICE_ACCESS_KEY=changeme
SVC_DOCSERVICE_SECRET_KEY=changeme
SVC_WORKER_ACCESS_KEY=changeme
SVC_WORKER_SECRET_KEY=changeme

# --- Redis (dos instancias logicas: streams y ratelimit, SPEC §3.5) ---
REDIS_STREAMS_PASSWORD=changeme
REDIS_RATELIMIT_PASSWORD=changeme
REDIS_STREAM_KEY=stream:pdf-processing
REDIS_CONSUMER_GROUP=extraction-workers
REDIS_DLQ_KEY=stream:pdf-processing-dlq

# --- MongoDB (Replica Set rs0) ---
MONGO_INITDB_ROOT_USERNAME=changeme
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_DATABASE=documents
# doc-service: readWrite sobre la base
MONGO_APP_USER=changeme
MONGO_APP_PASSWORD=changeme
# worker: SOLO update sobre la coleccion documents (ADR-0006)
MONGO_WORKER_USER=changeme
MONGO_WORKER_PASSWORD=changeme

# --- Monolito (Strangler, perfil full) ---
# Imagen construida desde el repo del monolito; no se publica puerto al host.
MONOLITO_IMAGE=monolito:latest
MONOLITO_BUILD_CONTEXT=../../../pdf-extractext
MONOLITO_PORT=8000
MONOLITO_MONGO_DB=pdf-extractext

# --- doc-service (perfil full): contrato v2 + webhook + reconciliador ---
# La imagen se construye desde su repo (contexto relativo a infra/compose/).
DOC_SERVICE_IMAGE=doc-service:latest
DOC_SERVICE_BUILD_CONTEXT=../../doc-service
# Token compartido del webhook MinIO -> doc-service (SPEC §5.2, S3-P2-06).
MINIO_WEBHOOK_SECRET=changeme
# Token de proteccion de los endpoints internos /internal/* (reconciliador, etc.).
INTERNAL_TOKEN=changeme
# URL del webhook dentro de la red `data` (no se publica al host).
DOC_SERVICE_WEBHOOK_URL=http://doc-service:8080/internal/storage/events

# --- Traefik: puertos publicados al host (ajustar si 80/443 estan ocupados) ---
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443

# --- Observabilidad ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
